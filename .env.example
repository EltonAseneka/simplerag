# ============================================================
# Environment Variables Configuration for SimpleRAG
# ============================================================

# Google Gemini API Key (Required for ChatGoogleGenerativeAI and optional Google embeddings)
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Required if using OpenAIEmbeddings or OpenAI Chat models)
# Obtain from OpenAI Platform: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
