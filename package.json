{
  "name": "simplerag",
  "version": "1.0.0",
  "description": "Production-grade Document Retrieval-Augmented Generation (RAG) with LangChain and Node.js",
  "main": "rag.js",
  "scripts": {
    "test": "node --require ./tests/setup.js --test",
    "test:coverage": "c8 --reporter=text --reporter=lcov node --require ./tests/setup.js --test",
    "check-coverage": "c8 --check-coverage --lines 70 --functions 70 --branches 65 node --require ./tests/setup.js --test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "node rag.js",
    "diagnostics": "node morerag.js"
  },
  "keywords": [
    "langchain",
    "rag",
    "hnswlib",
    "embeddings",
    "gemini",
    "openai"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@langchain/classic": "^1.0.32",
    "@langchain/community": "^1.1.27",
    "@langchain/core": "^1.1.44",
    "@langchain/google-genai": "^2.1.30",
    "@langchain/openai": "^1.6.3",
    "chalk": "^5.6.2",
    "dotenv": "^16.4.5",
    "hnswlib-node": "^3.0.0",
    "langchain": "^1.3.5",
    "mammoth": "^1.12.0",
    "pdf-parse": "^1.1.1",
    "readline": "^1.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "eslint": "^10.13.0"
  }
}
